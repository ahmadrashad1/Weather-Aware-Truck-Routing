# Copy to .env. For local development with `manage.py runserver`, only TOMTOM_API_KEY and
# DJANGO_DEBUG=true are needed.

# Required in production. Generate one with: openssl rand -base64 48
DJANGO_SECRET_KEY=
# true for local development only. Leave empty in production.
DJANGO_DEBUG=
# Required in production: comma-separated hostnames this app is served from.
ALLOWED_HOSTS=
# Only needed if the frontend is on a different origin: comma-separated, with https://.
CORS_ALLOWED_ORIGINS=
# Optional. Without it the app caches in its own process, which suits one server.
REDIS_URL=
# Required: https://developer.tomtom.com
TOMTOM_API_KEY=
# Optional. Open-Meteo's free tier is for non-commercial use, so commercial use needs a paid key.
OPEN_METEO_API_KEY=
# How many trusted proxies are in front of the backend: 0 if none. docker-compose.yml defaults to 1.
# Add one for each load balancer in front of that, or all users will share one rate limit.
NUM_PROXIES=
# Set to false only if nothing in front of the app serves HTTPS. docker-compose.yml defaults to false.
DJANGO_SECURE_SSL_REDIRECT=
